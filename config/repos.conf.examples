#!/bin/bash
# repos.conf.examples
# Configuration examples for different setups
# Copy this file to repos.conf and customize for your needs

# ============================================================================
# EXAMPLE 1: Standard ~/dev setup (Default)
# ============================================================================

WORKSPACE_DIR="$HOME/dev"
SYMLINK_DIR="${SYMLINK_DIR:-$WORKSPACE_DIR}"

declare -A REPOS=(
    ["my-frontend"]="$WORKSPACE_DIR/my-frontend:3000"
    ["my-backend"]="$WORKSPACE_DIR/my-backend:3001"
)

declare -A PROFILES=(
    ["full-stack"]="my-frontend,my-backend"
)

ENV_MAPPINGS=(
    "my-frontend:API_URL:my-backend:0"
)

PORT_INCREMENT=1000

