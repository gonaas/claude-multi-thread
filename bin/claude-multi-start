#!/bin/bash

# Claude Code Multi-Start
# Start multiple related repositories with automatic port management
# Usage: claude-multi-start [branch-name] [--profile <profile>] [--repos <repo1,repo2>]

set -e

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# Detect script location and load configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="$(dirname "$SCRIPT_DIR")/config"
REPOS_CONF="$CONFIG_DIR/repos.conf"

if [ ! -f "$REPOS_CONF" ]; then
    echo -e "${RED}Error: Configuration file not found at $REPOS_CONF${NC}"
    echo "Please create the configuration file first."
    exit 1
fi

source "$REPOS_CONF"

# Set default SYMLINK_DIR if not configured
SYMLINK_DIR="${SYMLINK_DIR:-$HOME/dev}"

# ============================================================================
# HELPER FUNCTIONS
# ============================================================================

show_help() {
    cat << 'EOF'
🚀 Claude Multi-Start - Launch Multiple Related Repositories

USAGE:
  claude-multi-start [branch-name] [options]
  cms [branch-name] [options]

OPTIONS:
  --profile <name>       Use a predefined profile from repos.conf
  --repos <repo1,repo2>  Manually select repositories (comma-separated)
  --install-deps         Install dependencies for all repos
  -i                     Short for --install-deps
  --help                 Show this help

EXAMPLES:
  # Interactive selection
  cms feature/auth

  # Use predefined profile
  cms feature/auth --profile full-stack

  # Manual selection
  cms develop --repos nuela-next,nuela-apiv2

  # With dependency installation
  cms feature/test --profile frontend-backend --install-deps

PREDEFINED PROFILES:
EOF
    for profile in "${!PROFILES[@]}"; do
        echo "  - $profile: ${PROFILES[$profile]}"
    done
}

get_next_instance_number() {
    # Determine the actual temp directory (handles macOS symlink)
    local actual_tmp="/tmp"
    if [ -L "/tmp" ]; then
        actual_tmp=$(readlink -f /tmp 2>/dev/null || echo "/private/tmp")
    fi

    # Find all claude-multi-stack directories
    local existing=$(find "$actual_tmp" -maxdepth 1 -type d -name "claude-multi-stack-*" 2>/dev/null | wc -l | tr -d ' ')

    # Return next number (0-indexed becomes 1-indexed)
    echo $((existing))
}

get_repo_path() {
    local repo_name="$1"
    local repo_info="${REPOS[$repo_name]}"
    echo "${repo_info%%:*}"
}

get_repo_base_port() {
    local repo_name="$1"
    local repo_info="${REPOS[$repo_name]}"
    echo "${repo_info##*:}"
}

calculate_port() {
    local base_port="$1"
    local instance_num="$2"
    echo $((base_port + (PORT_INCREMENT * instance_num)))
}

# Interactive repository selection
select_repos_interactive() {
    echo -e "${BLUE}📦 Available repositories:${NC}"
    local repo_array=()
    local i=1

    for repo in "${!REPOS[@]}"; do
        repo_array+=("$repo")
        local path=$(get_repo_path "$repo")
        local port=$(get_repo_base_port "$repo")
        echo -e "  ${CYAN}$i)${NC} $repo ${YELLOW}($path - port $port)${NC}"
        ((i++))
    done

    echo ""
    echo -e "${BLUE}Enter repository numbers (comma-separated, e.g., 1,2,3):${NC}"
    read -r selection

    # Parse selection
    IFS=',' read -ra INDICES <<< "$selection"
    local selected_repos=()

    for index in "${INDICES[@]}"; do
        index=$(echo "$index" | xargs)  # trim whitespace
        if [[ "$index" =~ ^[0-9]+$ ]] && [ "$index" -ge 1 ] && [ "$index" -le "${#repo_array[@]}" ]; then
            selected_repos+=("${repo_array[$((index - 1))]}")
        else
            echo -e "${RED}Invalid selection: $index${NC}"
            return 1
        fi
    done

    echo "${selected_repos[@]}"
}

# ============================================================================
# PARSE ARGUMENTS
# ============================================================================

BRANCH_NAME=""
PROFILE=""
SELECTED_REPOS=""
INSTALL_DEPS=false

while [ $# -gt 0 ]; do
    case "$1" in
        --profile)
            PROFILE="$2"
            shift 2
            ;;
        --repos)
            SELECTED_REPOS="$2"
            shift 2
            ;;
        --install-deps|-i)
            INSTALL_DEPS=true
            shift
            ;;
        --help)
            show_help
            exit 0
            ;;
        *)
            if [ -z "$BRANCH_NAME" ]; then
                BRANCH_NAME="$1"
            fi
            shift
            ;;
    esac
done

# Check branch name
if [ -z "$BRANCH_NAME" ]; then
    echo -e "${RED}Error: Branch name required${NC}"
    echo "Usage: claude-multi-start <branch-name> [options]"
    echo "Use --help for more information"
    exit 1
fi

# ============================================================================
# SELECT REPOSITORIES
# ============================================================================

REPOS_TO_OPEN=()

if [ -n "$PROFILE" ]; then
    # Use profile
    if [ -z "${PROFILES[$PROFILE]}" ]; then
        echo -e "${RED}Error: Profile '$PROFILE' not found${NC}"
        echo "Available profiles:"
        for p in "${!PROFILES[@]}"; do
            echo "  - $p"
        done
        exit 1
    fi
    IFS=',' read -ra REPOS_TO_OPEN <<< "${PROFILES[$PROFILE]}"
    echo -e "${GREEN}✓${NC} Using profile: ${CYAN}$PROFILE${NC}"
elif [ -n "$SELECTED_REPOS" ]; then
    # Manual selection
    IFS=',' read -ra REPOS_TO_OPEN <<< "$SELECTED_REPOS"
    echo -e "${GREEN}✓${NC} Selected repositories: ${CYAN}${REPOS_TO_OPEN[*]}${NC}"
else
    # Interactive selection
    selected=$(select_repos_interactive)
    if [ $? -ne 0 ]; then
        exit 1
    fi
    read -ra REPOS_TO_OPEN <<< "$selected"
fi

# Trim whitespace from repo names
for i in "${!REPOS_TO_OPEN[@]}"; do
    REPOS_TO_OPEN[$i]=$(echo "${REPOS_TO_OPEN[$i]}" | xargs)
done

echo -e "${BLUE}📋 Repositories to open:${NC}"
for repo in "${REPOS_TO_OPEN[@]}"; do
    echo -e "  ${CYAN}•${NC} $repo"
done

# ============================================================================
# GET INSTANCE NUMBER
# ============================================================================

INSTANCE_NUM=$(get_next_instance_number)
echo -e "${BLUE}🔢 Instance number:${NC} $INSTANCE_NUM"

# ============================================================================
# CREATE SESSION DIRECTORY
# ============================================================================

SESSION_ID="$$"
SESSION_DIR="/tmp/claude-multi-stack-$INSTANCE_NUM-$SESSION_ID"
mkdir -p "$SESSION_DIR"

echo -e "${BLUE}📁 Session directory:${NC} $SESSION_DIR"

# Save session metadata
cat > "$SESSION_DIR/.session-info" << EOF
INSTANCE_NUM=$INSTANCE_NUM
BRANCH_NAME=$BRANCH_NAME
REPOS=(${REPOS_TO_OPEN[@]})
CREATED_AT=$(date)
EOF

# ============================================================================
# CLONE AND SETUP REPOSITORIES
# ============================================================================

declare -A TEMP_DIRS
declare -A PORTS

echo ""
echo -e "${BLUE}🚀 Setting up repositories...${NC}"
echo ""

for repo in "${REPOS_TO_OPEN[@]}"; do
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}📦 Setting up: ${CYAN}$repo${NC}"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

    # Get repo info
    REPO_PATH=$(get_repo_path "$repo")
    BASE_PORT=$(get_repo_base_port "$repo")
    NEW_PORT=$(calculate_port "$BASE_PORT" "$INSTANCE_NUM")

    PORTS[$repo]=$NEW_PORT

    echo -e "${BLUE}📂 Source:${NC} $REPO_PATH"
    echo -e "${BLUE}🌿 Branch:${NC} $BRANCH_NAME"
    echo -e "${BLUE}🔌 Port:${NC} $BASE_PORT → ${GREEN}$NEW_PORT${NC}"

    # Create temp dir for this repo
    TEMP_DIR="$SESSION_DIR/$repo"
    TEMP_DIRS[$repo]=$TEMP_DIR

    # Check if repo exists
    if [ ! -d "$REPO_PATH/.git" ]; then
        echo -e "${RED}Error: $repo not found at $REPO_PATH${NC}"
        echo "Please update repos.conf with the correct path"
        continue
    fi

    # Get repo URL
    cd "$REPO_PATH"
    REPO_URL=$(git config --get remote.origin.url)

    # Clone
    echo -e "${BLUE}⬇️  Cloning...${NC}"
    git clone --depth 1 --branch "$BRANCH_NAME" --single-branch "$REPO_URL" "$TEMP_DIR" 2>/dev/null || {
        echo -e "${YELLOW}⚠️  Branch not found remotely, cloning full repo...${NC}"
        git clone "$REPO_URL" "$TEMP_DIR"
        cd "$TEMP_DIR"
        git checkout -b "$BRANCH_NAME" 2>/dev/null || git checkout "$BRANCH_NAME"
    }

    cd "$TEMP_DIR"

    # Copy config files
    echo -e "${BLUE}📋 Copying config files...${NC}"
    for config_file in .env .env.local .env.development .env.production .npmrc .yarnrc .prettierrc; do
        if [ -f "$REPO_PATH/$config_file" ]; then
            cp "$REPO_PATH/$config_file" "$TEMP_DIR/" 2>/dev/null && \
                echo -e "  ${GREEN}✓${NC} $config_file"
        fi
    done

    # Update port in .env files
    echo -e "${BLUE}🔧 Updating ports...${NC}"
    for env_file in .env .env.local .env.development .env.production; do
        if [ -f "$env_file" ]; then
            # Update PORT variable
            if grep -q "^PORT=" "$env_file" 2>/dev/null; then
                sed -i.bak "s/^PORT=.*/PORT=$NEW_PORT/" "$env_file" && \
                    echo -e "  ${GREEN}✓${NC} Updated PORT in $env_file"
                rm -f "$env_file.bak"
            fi
        fi
    done

    echo ""
done

# ============================================================================
# UPDATE CROSS-SERVICE URLS
# ============================================================================

echo -e "${BLUE}🔗 Updating service URLs...${NC}"

for mapping in "${ENV_MAPPINGS[@]}"; do
    IFS=':' read -r source_repo env_var target_repo port_offset <<< "$mapping"

    # Check if both repos are in our selection
    if [[ " ${REPOS_TO_OPEN[@]} " =~ " ${source_repo} " ]] && [[ " ${REPOS_TO_OPEN[@]} " =~ " ${target_repo} " ]]; then
        source_dir="${TEMP_DIRS[$source_repo]}"
        target_port="${PORTS[$target_repo]}"

        new_url="http://localhost:$target_port"

        # Update in all .env files
        for env_file in "$source_dir"/.env*; do
            if [ -f "$env_file" ]; then
                if grep -q "^${env_var}=" "$env_file" 2>/dev/null; then
                    sed -i.bak "s|^${env_var}=.*|${env_var}=${new_url}|" "$env_file"
                    echo -e "  ${GREEN}✓${NC} $source_repo: $env_var → $new_url"
                    rm -f "$env_file.bak"
                fi
            fi
        done
    fi
done

# ============================================================================
# INSTALL DEPENDENCIES
# ============================================================================

if [ "$INSTALL_DEPS" = true ]; then
    echo ""
    echo -e "${BLUE}📦 Installing dependencies...${NC}"

    for repo in "${REPOS_TO_OPEN[@]}"; do
        TEMP_DIR="${TEMP_DIRS[$repo]}"
        cd "$TEMP_DIR"

        if [ -f "package.json" ]; then
            echo -e "${CYAN}Installing for $repo...${NC}"
            if [ -f "pnpm-lock.yaml" ]; then
                pnpm install
            elif [ -f "yarn.lock" ]; then
                yarn install
            else
                npm install
            fi
        fi
    done
fi

# ============================================================================
# CREATE SYMLINKS
# ============================================================================

echo ""
echo -e "${BLUE}🔗 Creating symlinks...${NC}"

mkdir -p "$SYMLINK_DIR"

for repo in "${REPOS_TO_OPEN[@]}"; do
    SYMLINK_NAME="${repo}-${BRANCH_NAME}-i${INSTANCE_NUM}"
    SYMLINK_NAME=$(echo "$SYMLINK_NAME" | tr '/' '-')
    SYMLINK_PATH="$SYMLINK_DIR/$SYMLINK_NAME"

    if [ -L "$SYMLINK_PATH" ] || [ -e "$SYMLINK_PATH" ]; then
        rm -rf "$SYMLINK_PATH"
    fi

    ln -s "${TEMP_DIRS[$repo]}" "$SYMLINK_PATH"
    echo -e "  ${GREEN}✓${NC} $SYMLINK_DIR/$SYMLINK_NAME"
done

# ============================================================================
# OPEN CLAUDE CODE
# ============================================================================

echo ""
echo -e "${GREEN}✓ Setup complete!${NC}"
echo ""
echo -e "${BLUE}🚀 Opening Claude Code instances...${NC}"

for repo in "${REPOS_TO_OPEN[@]}"; do
    TEMP_DIR="${TEMP_DIRS[$repo]}"
    PORT="${PORTS[$repo]}"

    echo -e "${CYAN}Opening $repo (port $PORT)...${NC}"
    claude "$TEMP_DIR" &
    sleep 2
done

# ============================================================================
# SUMMARY
# ============================================================================

echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✓ All repositories opened successfully!${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo -e "${BLUE}📊 Summary:${NC}"
echo -e "${BLUE}  Instance:${NC} #$INSTANCE_NUM"
echo -e "${BLUE}  Branch:${NC} $BRANCH_NAME"
echo -e "${BLUE}  Repositories:${NC}"

for repo in "${REPOS_TO_OPEN[@]}"; do
    PORT="${PORTS[$repo]}"
    SYMLINK_NAME="${repo}-${BRANCH_NAME}-i${INSTANCE_NUM}"
    SYMLINK_NAME=$(echo "$SYMLINK_NAME" | tr '/' '-')
    echo -e "    ${CYAN}•${NC} $repo ${YELLOW}(port $PORT)${NC} → $SYMLINK_DIR/$SYMLINK_NAME"
done

echo ""
echo -e "${BLUE}💡 Quick access:${NC}"
for repo in "${REPOS_TO_OPEN[@]}"; do
    SYMLINK_NAME="${repo}-${BRANCH_NAME}-i${INSTANCE_NUM}"
    SYMLINK_NAME=$(echo "$SYMLINK_NAME" | tr '/' '-')
    echo -e "  cd $SYMLINK_DIR/$SYMLINK_NAME"
done

echo ""
echo -e "${BLUE}🧹 To cleanup:${NC}"
echo -e "  cmc  # Cleanup all instances"

echo ""
