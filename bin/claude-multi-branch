#!/bin/bash

# Claude Code Multi-Branch Opener
# Usage: claude-multi-branch <branch-name> [repo-path] [--install-deps|-i]

set -e

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Load configuration if available
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="$(dirname "$SCRIPT_DIR")/config"
REPOS_CONF="$CONFIG_DIR/repos.conf"

if [ -f "$REPOS_CONF" ]; then
    source "$REPOS_CONF"
fi

# Set default SYMLINK_DIR
SYMLINK_DIR="${SYMLINK_DIR:-$HOME/dev}"

# Parse arguments
INSTALL_DEPS=false
BRANCH_NAME=""
REPO_PATH="."

for arg in "$@"; do
    case $arg in
        --install-deps|-i)
            INSTALL_DEPS=true
            ;;
        *)
            if [ -z "$BRANCH_NAME" ]; then
                BRANCH_NAME="$arg"
            else
                REPO_PATH="$arg"
            fi
            ;;
    esac
done

# Check arguments
if [ -z "$BRANCH_NAME" ]; then
    echo -e "${RED}Error: You must specify a branch${NC}"
    echo "Usage: claude-multi-branch <branch-name> [repo-path] [--install-deps|-i]"
    echo "Example: claude-multi-branch feature/new-feature"
    echo "         claude-multi-branch main ~/projects/my-app"
    echo "         claude-multi-branch feature/test --install-deps"
    exit 1
fi

# Verify we're in a git repo
if [ ! -d "$REPO_PATH/.git" ]; then
    echo -e "${RED}Error: $REPO_PATH is not a git repository${NC}"
    exit 1
fi

# Get repo information
cd "$REPO_PATH"
# Save absolute path of original repo before changing directories
ORIGINAL_REPO_PATH="$(pwd)"
REPO_URL=$(git config --get remote.origin.url)
# Get real repo name from current directory or from remote URL
if [ "$REPO_PATH" = "." ]; then
    REPO_NAME=$(basename "$(pwd)")
else
    REPO_NAME=$(basename "$REPO_PATH")
fi

echo -e "${BLUE}📦 Repository:${NC} $REPO_NAME"
echo -e "${BLUE}🌿 Branch:${NC} $BRANCH_NAME"

# Create temporary directory
TEMP_DIR="/tmp/claude-multi-branch-${REPO_NAME}-${BRANCH_NAME}-$$"
SYMLINK_NAME="${REPO_NAME}-${BRANCH_NAME}"
SYMLINK_PATH="$SYMLINK_DIR/$SYMLINK_NAME"
echo -e "${BLUE}📁 Creating temporary clone at:${NC} $TEMP_DIR"

# Clone repo with shallow clone for speed
echo -e "${BLUE}⬇️  Cloning repository...${NC}"
git clone --depth 1 --branch "$BRANCH_NAME" --single-branch "$REPO_URL" "$TEMP_DIR" 2>/dev/null || {
    # If branch doesn't exist remotely, clone and create locally
    echo -e "${YELLOW}⚠️  Branch not found remotely, cloning full repo...${NC}"
    git clone "$REPO_URL" "$TEMP_DIR"
    cd "$TEMP_DIR"
    git checkout -b "$BRANCH_NAME" 2>/dev/null || git checkout "$BRANCH_NAME"
}

cd "$TEMP_DIR"

# Copy .env and other config files if they exist
echo -e "${BLUE}📋 Copying configuration files...${NC}"
config_copied=false
for config_file in .env .env.local .env.development .env.production .npmrc .yarnrc .prettierrc; do
    if [ -f "$ORIGINAL_REPO_PATH/$config_file" ]; then
        if cp "$ORIGINAL_REPO_PATH/$config_file" "$TEMP_DIR/" 2>/dev/null; then
            echo -e "${GREEN}✓${NC} Copied $config_file"
            config_copied=true
        else
            echo -e "${YELLOW}⚠${NC}  Failed to copy $config_file"
        fi
    fi
done
if [ "$config_copied" = false ]; then
    echo -e "${YELLOW}⚠${NC}  No configuration files found to copy"
fi

# Install dependencies if package.json exists
if [ -f "package.json" ] && [ "$INSTALL_DEPS" = true ]; then
    echo -e "${BLUE}📦 Installing dependencies...${NC}"
    if [ -f "pnpm-lock.yaml" ]; then
        echo -e "${BLUE}Installing with pnpm...${NC}"
        pnpm install
    elif [ -f "yarn.lock" ]; then
        echo -e "${BLUE}Installing with yarn...${NC}"
        yarn install
    else
        echo -e "${BLUE}Installing with npm...${NC}"
        npm install
    fi
elif [ -f "package.json" ]; then
    echo -e "${YELLOW}💡 Tip: Use --install-deps or -i to install dependencies automatically${NC}"
fi

# Create symlink
echo -e "${BLUE}🔗 Creating symlink...${NC}"
mkdir -p "$SYMLINK_DIR"
if [ -L "$SYMLINK_PATH" ] || [ -e "$SYMLINK_PATH" ]; then
    echo -e "${YELLOW}⚠${NC}  Removing existing symlink/directory: $SYMLINK_NAME"
    rm -rf "$SYMLINK_PATH"
fi
ln -s "$TEMP_DIR" "$SYMLINK_PATH"
echo -e "${GREEN}✓${NC} Symlink created: $SYMLINK_DIR/$SYMLINK_NAME -> $TEMP_DIR"

echo -e "${GREEN}✓ Ready!${NC}"
echo -e "${BLUE}🚀 Opening Claude Code...${NC}"

# Open Claude Code
claude "$TEMP_DIR"

# Cleanup message
echo ""
echo -e "${BLUE}💡 Symlink available at:${NC} $SYMLINK_DIR/$SYMLINK_NAME"
echo -e "${BLUE}💡 To cleanup later:${NC}"
echo -e "   rm -rf $TEMP_DIR"
echo -e "   rm $SYMLINK_PATH"
echo -e "${BLUE}💡 Or use:${NC}"
echo -e "   claude-multi-cleanup"

# Print temp dir for the shell function to use
echo "TEMP_DIR=$TEMP_DIR"
echo "SYMLINK_PATH=$SYMLINK_PATH"
